# ---- Python ----
__pycache__/
*.pyc
.venv/

# ---- 打包产物与构建中间物 ----
build/
dist/
dist_*/
发布/
*.spec

# ---- 开发产物（截图 / 验证副本 / 备份）----
_check/
logs/
.temp_crop_*.png
selftest_out*.txt
# 探针逐帧截图（每轮几 MB，没版本意义）与旧实现副本、临时提取物
devtools/_frames*/
devtools/_qa_old_impl/
devtools/_tmp_*
devtools/rec/

# ---- 本机助手数据（不进仓库）----
.workbuddy/

# ---- Windows 保留设备名垃圾文件（nul 无法被任何 Win32 API 删除，仅 gitignore 排除）----
/nul

# ---- 构建日志 / 临时产物（od 轮次留下的）----
build_*/
_build_*.log
.build*.log
_selftest_*.log
_net_out.txt
*.genie

# ---- 开屏逐帧序列（每套 20MB+，构建时本地生成；只保留 mp4/poster/json 进仓库）----
assets/splash/*_frames/
build_*.log
devtools/_*_tmp/

# 发布脚本留下来的日志（每次发布一份，没版本意义）
release_od*.log
